<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MyRepublic — Pusat Bantuan & Penanganan Kendala Pelanggan</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style is:global>
        :root {
            --navy:        #0d0a0b;
            --navy2:       #1a0f10;
            --navy3:       #2a1215;
            --accent:      #e30613;
            --accent2:     #ff3344;
            --accent-glow: rgba(227,6,19,0.15);
            --text:        #f5e8e9;
            --text-muted:  #b89496;
            --border:      rgba(227,6,19,0.22);
            --border-soft: rgba(255,255,255,0.06);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--navy);
            color: var(--text);
            overflow-x: hidden;
            line-height: 1.6;
        }
        body::before {
            content: '';
            position: fixed; inset: 0;
            background-image:
                linear-gradient(rgba(227,6,19,0.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(227,6,19,0.04) 1px, transparent 1px);
            background-size: 60px 60px;
            pointer-events: none; z-index: 0;
        }
        .container { max-width: 1120px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 1; }

        /* ── NAVBAR ── */
        nav {
            position: fixed; top: 0; left: 0; right: 0;
            padding: 0; z-index: 999;
            border-bottom: 1px solid var(--border-soft);
            backdrop-filter: blur(20px);
            background: rgba(13,10,11,0.88);
        }
        .nav-inner {
            max-width: 1120px; margin: 0 auto; padding: 0 24px;
            display: flex; justify-content: space-between; align-items: center;
            height: 68px;
        }
        .logo {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 22px; font-weight: 700;
            text-decoration: none; color: var(--text);
            letter-spacing: -0.5px;
            display: flex; align-items: center; gap: 10px;
        }
        .nav-links { display: flex; align-items: center; gap: 6px; }
        .nav-links a {
            text-decoration: none; color: var(--text-muted);
            font-size: 14px; font-weight: 500;
            padding: 8px 16px; border-radius: 8px;
            transition: all 0.2s;
        }
        .nav-links a:hover { color: var(--text); background: var(--border-soft); }
        .btn-nav-cta {
            background: var(--accent) !important;
            color: white !important;
            border-radius: 8px !important;
            font-weight: 600 !important;
        }
        .btn-nav-cta:hover { background: var(--accent2) !important; }
        @media (max-width: 768px) { .nav-links { display: none; } }

        /* ── HERO ── */
        .hero {
            min-height: 50vh;
            display: flex; align-items: center;
            padding: 120px 0 50px;
            position: relative; overflow: hidden;
            text-align: center;
        }
        .hero-glow {
            position: absolute; top: 20%; left: 50%;
            transform: translateX(-50%);
            width: 800px; height: 400px;
            background: radial-gradient(ellipse, rgba(227,6,19,0.13) 0%, transparent 70%);
            pointer-events: none;
        }
        .orb {
            position: absolute; border-radius: 50%;
            filter: blur(80px); pointer-events: none;
            animation: float 8s ease-in-out infinite;
        }
        .orb1 { width: 260px; height: 260px; background: rgba(227,6,19,0.08); top: 15%; left: 5%; }
        .orb2 { width: 180px; height: 180px; background: rgba(180,20,30,0.06); top: 55%; right: 5%; animation-delay: -3s; }
        @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }

        .hero-eyebrow {
            display: inline-flex; align-items: center; gap: 8px;
            background: rgba(227,6,19,0.08);
            border: 1px solid var(--border);
            padding: 6px 16px; border-radius: 100px;
            font-size: 12px; font-weight: 600; letter-spacing: 1px;
            text-transform: uppercase; color: var(--accent2);
            margin-bottom: 28px;
        }
        .eyebrow-dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--accent);
            animation: pulse 2s infinite;
        }
        @keyframes pulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:.5; transform:scale(.8); } }

        .hero h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: clamp(32px, 5vw, 56px);
            font-weight: 700; line-height: 1.1;
            letter-spacing: -1.5px; color: #fff;
            margin-bottom: 20px;
        }
        .h1-accent {
            background: linear-gradient(90deg, var(--accent), var(--accent2), #ff8c94);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero p {
            font-size: 17px; color: var(--text-muted);
            max-width: 600px; margin: 0 auto 36px; line-height: 1.7;
        }
        .hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
        .btn-primary {
            background: var(--accent); color: white;
            padding: 14px 28px; border-radius: 10px;
            text-decoration: none; font-weight: 600; font-size: 15px;
            display: inline-flex; align-items: center; gap: 8px;
            transition: all 0.25s;
            cursor: pointer;
            border: none;
        }
        .btn-primary:hover { background: var(--accent2); transform: translateY(-2px); box-shadow: 0 8px 28px rgba(227,6,19,0.3); }
        .btn-ghost {
            background: transparent; color: var(--text);
            border: 1px solid var(--border);
            padding: 14px 28px; border-radius: 10px;
            text-decoration: none; font-weight: 600; font-size: 15px;
            display: inline-flex; align-items: center; gap: 8px;
            transition: all 0.25s;
        }
        .btn-ghost:hover { background: var(--border-soft); border-color: var(--accent); color: var(--accent2); transform: translateY(-2px); }

        /* ── SECTION COMMON ── */
        .section-label {
            font-size: 12px; font-weight: 700; letter-spacing: 2px;
            text-transform: uppercase; color: var(--accent); margin-bottom: 12px;
        }
        .section-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 700; letter-spacing: -1px;
            color: #fff; margin-bottom: 12px;
        }

        /* ── TROUBLESHOOTING GRID ── */
        .trouble-section { padding: 60px 0 80px; }
        .t-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 32px; }
        .t-card {
            background: var(--navy2); border: 1px solid var(--border-soft);
            border-radius: 16px; padding: 28px; transition: all 0.3s;
        }
        .t-card:hover { border-color: var(--accent); transform: translateY(-4px); }
        .t-icon { font-size: 32px; margin-bottom: 16px; }
        .t-title { font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 10px; }
        .t-desc { font-size: 14px; color: var(--text-muted); line-height: 1.6; margin-bottom: 16px; }
        .t-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
        .t-list li { font-size: 13.5px; color: var(--text-muted); display: flex; align-items: flex-start; gap: 8px; }
        .t-list li::before { content: '•'; color: var(--accent2); font-weight: bold; }

        /* ── CTA BAND ── */
        .cta-band { padding: 60px 0; border-top: 1px solid var(--border-soft); }
        .cta-box {
            background: var(--navy2); border: 1px solid var(--border);
            border-radius: 20px; padding: 48px; text-align: center;
            position: relative; overflow: hidden;
        }
        .cta-box h2 { font-family: 'Space Grotesk', sans-serif; font-size: clamp(22px, 3.5vw, 32px); font-weight: 700; color: #fff; margin-bottom: 12px; }
        .cta-box p { font-size: 15px; color: var(--text-muted); margin-bottom: 24px; }

        /* ── FOOTER ── */
        footer { border-top: 1px solid var(--border-soft); padding: 36px 0; text-align: center; }
        .footer-logo { font-family: 'Space Grotesk', sans-serif; font-size: 17px; font-weight: 700; color: var(--text-muted); margin-bottom: 6px; }
        .footer-logo span { color: var(--accent); }
        footer p { font-size: 13px; color: var(--text-muted); }

        /* ── SINGLE CHAT BUTTON ── */
        .chat-buttons {
            position: fixed; bottom: 28px; right: 28px;
            z-index: 1001;
        }
        .chat-btn-komplain {
            display: flex; align-items: center; gap: 10px;
            border: none; border-radius: 50px;
            padding: 14px 24px; font-weight: 700; font-size: 14px;
            cursor: pointer; transition: all 0.25s;
            font-family: 'Inter', sans-serif; white-space: nowrap;
            box-shadow: 0 8px 25px rgba(227,6,19,0.4);
            background: var(--accent); color: white;
        }
        .chat-btn-komplain:hover { transform: translateY(-2px); background: var(--accent2); box-shadow: 0 12px 32px rgba(227,6,19,0.6); }
        .chat-dot { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; animation: pulse 2s infinite; }

        /* ── CHAT WINDOW ── */
        .chat-window {
            position: fixed; bottom: 100px; right: 28px;
            width: 390px; height: 560px;
            background: var(--navy2); border: 1px solid var(--border);
            border-radius: 20px; display: none; flex-direction: column;
            box-shadow: 0 24px 60px rgba(0,0,0,0.6);
            z-index: 1002; overflow: hidden; font-family: 'Inter', sans-serif;
        }
        .chat-window.show { display: flex; animation: slideUp 0.3s cubic-bezier(0.34,1.56,0.64,1); }
        @keyframes slideUp { from { opacity:0; transform:translateY(16px) scale(.97); } to { opacity:1; transform:translateY(0) scale(1); } }

        .chat-header.komplain-header { background: linear-gradient(135deg, #8b0000, #e30613); padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; }
        .chat-agent { display: flex; align-items: center; gap: 12px; }
        .agent-avatar { width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 18px; }
        .agent-name { font-weight: 700; font-size: 14px; color: white; }
        .agent-status { font-size: 12px; color: rgba(255,255,255,0.8); display: flex; align-items: center; gap: 5px; }
        .status-online { width: 6px; height: 6px; border-radius: 50%; background: #4ade80; }
        .close-chat { background: none; border: none; color: rgba(255,255,255,0.7); font-size: 22px; cursor: pointer; padding: 0 4px; line-height: 1; }
        .close-chat:hover { color: white; }

        .chat-body { flex: 1; padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; background: var(--navy); }
        .chat-body::-webkit-scrollbar { width: 4px; }
        .chat-body::-webkit-scrollbar-thumb { background: var(--border-soft); border-radius: 2px; }

        .msg { padding: 10px 14px; border-radius: 14px; font-size: 13.5px; line-height: 1.5; max-width: 85%; word-break: break-word; }
        .msg.bot  { background: var(--navy2); color: var(--text); border: 1px solid var(--border-soft); border-bottom-left-radius: 4px; align-self: flex-start; white-space: pre-line; }
        .msg.user { background: var(--accent); color: white; border-bottom-right-radius: 4px; align-self: flex-end; }

        .typing { display: flex; gap: 4px; align-items: center; padding: 12px 16px; background: var(--navy2); border: 1px solid var(--border-soft); border-radius: 14px; border-bottom-left-radius: 4px; align-self: flex-start; }
        .typing span { width: 7px; height: 7px; border-radius: 50%; background: var(--text-muted); animation: bounce 1.4s infinite; }
        .typing span:nth-child(2) { animation-delay: 0.2s; }
        .typing span:nth-child(3) { animation-delay: 0.4s; }
        @keyframes bounce { 0%,80%,100% { transform:translateY(0); } 40% { transform:translateY(-6px); } }

        .chat-footer { padding: 12px 14px; border-top: 1px solid var(--border-soft); display: flex; gap: 8px; background: var(--navy2); }
        .chat-input {
            flex: 1; background: var(--navy); border: 1px solid var(--border-soft);
            color: var(--text); padding: 10px 14px; border-radius: 10px;
            font-size: 13.5px; outline: none; transition: border-color 0.2s;
            font-family: 'Inter', sans-serif;
        }
        .chat-input:focus { border-color: var(--accent); }
        .chat-input::placeholder { color: var(--text-muted); }
        .chat-send { background: var(--accent); color: white; border: none; width: 42px; border-radius: 10px; cursor: pointer; font-size: 16px; transition: background 0.2s; }
        .chat-send:hover { background: var(--accent2); }

        /* FAQ ACCORDION */
        .faq-item { background:var(--navy2); border:1px solid var(--border-soft); border-radius:12px; overflow:hidden; }
        .faq-q { padding:18px 22px; font-size:15px; font-weight:600; color:#fff; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:14px; user-select:none; }
        .faq-q:hover { color:var(--accent2); }
        .faq-arrow { font-size:18px; color:var(--accent); transition:transform .3s; flex-shrink:0; }
        .faq-item.open .faq-arrow { transform:rotate(45deg); }
        .faq-a { max-height:0; overflow:hidden; transition:max-height .35s ease; }
        .faq-item.open .faq-a { max-height:300px; }
        .faq-a p { padding:0 22px 18px; font-size:14px; color:var(--text-muted); line-height:1.8; }

        .reveal { opacity:0; transform:translateY(24px); transition: opacity .6s ease, transform .6s ease; }
        .reveal.visible { opacity:1; transform:translateY(0); }

        @media (max-width: 480px) {
            .chat-window { width: calc(100vw - 24px); right: 12px; bottom: 84px; height: 500px; }
            .chat-buttons { right: 12px; bottom: 12px; }
        }
    </style>
</head>
<body>

    <div class="orb orb1"></div>
    <div class="orb orb2"></div>

    <!-- ── NAVBAR ── -->
    <nav>
        <div class="nav-inner">
            <a href="#" class="logo">
                <span style="font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:800;color:#fff;">My<span style="color:var(--accent);">Republic</span> Support</span>
            </a>
            <div class="nav-links">
                <a href="#panduan">Panduan Troubleshooting</a>
                <a href="#faq">FAQ Kendala</a>
                <a href="https://wa.me/6288986000000" target="_blank" class="btn-nav-cta">WA Support Official</a>
            </div>
        </div>
    </nav>

    <!-- ── HERO ── -->
    <section class="hero">
        <div class="hero-glow"></div>
        <div class="container" style="width:100%;">
            <div class="hero-eyebrow"><span class="eyebrow-dot"></span> Customer Care & Helpdesk 24/7</div>
            <h1>
                Ada Kendala dengan<br>
                <span class="h1-accent">Layanan MyRepublic Anda?</span>
            </h1>
            <p>Sampaikan kendala Anda atau ikuti panduan mandiri di bawah. AI Support Agent kami siap membantu melakukan langkah penanganan awal dan penerbitan tiket bantuan teknis.</p>

            <div class="hero-actions">
                <button class="btn-primary" id="btn-hero-chat">📢 Laporkan Kendala Sekarang</button>
                <a href="#panduan" class="btn-ghost">🛠️ Lihat Panduan Mandiri</a>
            </div>
        </div>
    </section>

    <!-- ── PANDUAN TROUBLESHOOTING ── -->
    <section id="panduan" class="trouble-section">
        <div class="container">
            <p class="section-label reveal" style="text-align:center">PANDUAN EDUKASI</p>
            <h2 class="section-title reveal" style="text-align:center">Penanganan Mandiri Kendala Utama</h2>
            
            <div class="t-grid">
                <!-- Card 1 -->
                <div class="t-card reveal">
                    <div class="t-icon">🔴</div>
                    <div class="t-title">Indikator LOS Merah</div>
                    <div class="t-desc">Menandakan sinyal optik terputus atau tidak terdeteksi oleh modem ONT.</div>
                    <ul class="t-list">
                        <li>Cek kabel fiber (patch cord kuning) dari dinding ke modem, pastikan terpasang rapat.</li>
                        <li>Pastikan kabel tidak terlipat, tertekan, atau bengkok secara ekstrim.</li>
                        <li>Restart modem dengan mematikan tombol power selama 3–5 menit.</li>
                    </ul>
                </div>
                <!-- Card 2 -->
                <div class="t-card reveal">
                    <div class="t-icon">⚡</div>
                    <div class="t-title">Koneksi Lambat / Buffering</div>
                    <div class="t-desc">Lampu PON normal (hijau), tetapi kecepatan internet terasa lambat atau putus-putus.</div>
                    <ul class="t-list">
                        <li>Lakukan restart modem ONT (cabut adaptor 3–5 menit lalu colok kembali).</li>
                        <li>Gunakan koneksi Wi-Fi 5GHz atau kabel LAN untuk hasil optimal.</li>
                        <li>Uji kecepatan via speedtest.net / fast.com tanpa menggunakan VPN.</li>
                    </ul>
                </div>
                <!-- Card 3 -->
                <div class="t-card reveal">
                    <div class="t-icon">📺</div>
                    <div class="t-title">Kendala TV Kabel / STB</div>
                    <div class="t-desc">Layar TV tidak ada sinyal, lag, atau aplikasi streaming tidak dapat dibuka.</div>
                    <ul class="t-list">
                        <li>Pastikan STB terhubung dengan jaringan Wi-Fi/LAN MyRepublic secara stabil.</li>
                        <li>Restart modem ONT terlebih dahulu, tunggu hingga koneksi internet aktif.</li>
                        <li>Matikan dan nyalakan ulang perangkat STB MyRepublic Anda.</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- ── FAQ ── -->
    <section id="faq" style="padding:80px 0;background:var(--navy2);border-top:1px solid var(--border-soft);">
        <div class="container">
            <p class="section-label reveal" style="text-align:center">FAQ</p>
            <h2 class="section-title reveal" style="text-align:center">Pertanyaan Umum Seputar Kendala</h2>
            <div style="max-width:760px;margin:48px auto 0;display:flex;flex-direction:column;gap:12px;">
                <div class="faq-item reveal">
                    <div class="faq-q">Apa yang harus dilakukan jika lampu LOS berwarna merah berkedip? <span class="faq-arrow">+</span></div>
                    <div class="faq-a"><p>Lampu LOS merah menandakan terputusnya sambungan fisik Fiber Optic. Cek fisik kabel patch cord kuning. Jika kabel terpasang dengan benar tetapi LOS tetap merah setelah restart modem, kemungkinan terjadi FO Cut/pemeliharaan jaringan regional. Klik tombol "Komplain" di pojok bawah untuk pelaporan ke tim teknisi.</p></div>
                </div>
                <div class="faq-item reveal">
                    <div class="faq-q">Bagaimana cara cek tagihan dan pembayaran resmi MyRepublic? <span class="faq-arrow">+</span></div>
                    <div class="faq-a"><p>Anda dapat mengecek tagihan dan status pembayaran secara mandiri melalui Web Selfcare MyRepublic atau via WhatsApp Official MyRepublic di nomor 0889-8600-0000.</p></div>
                </div>
                <div class="faq-item reveal">
                    <div class="faq-q">Kenapa kecepatan hasil Speedtest tidak sesuai dengan paket? <span class="faq-arrow">+</span></div>
                    <div class="faq-a"><p>Kecepatan Wi-Fi dipengaruhi oleh jarak dari modem, ketebalan dinding, serta frekuensi Wi-Fi yang digunakan (2.4GHz vs 5GHz). Untuk pengujian akurat, gunakan kabel LAN langsung dari laptop/PC ke port LAN modem.</p></div>
                </div>
                <div class="faq-item reveal">
                    <div class="faq-q">Berapa lama proses penanganan kendala teknis oleh teknisi? <span class="faq-arrow">+</span></div>
                    <div class="faq-a"><p>Setelah AI Agent menerbitkan tiket laporan kendala Anda, tim teknisi MyRepublic akan melakukan pengecekan jaringan pusat dan menjadwalkan kunjungan lapangan sesuai slot ketersediaan (umumnya 1x24 jam).</p></div>
                </div>
            </div>
        </div>
    </section>

    <!-- ── CTA ── -->
    <section class="cta-band">
        <div class="container">
            <div class="cta-box reveal">
                <h2>Membutuhkan Bantuan Teknisi Lebih Lanjut?</h2>
                <p>Gunakan asisten AI Komplain untuk pengecekan cepat atau laporkan tiket perbaikan.</p>
                <div class="cta-actions" style="display:flex;justify-content:center;">
                    <button class="btn-primary" id="btn-cta-chat">💬 Mulai Chat Bantuan</button>
                </div>
            </div>
        </div>
    </section>

    <!-- ── FOOTER ── -->
    <footer>
        <div class="container">
            <div class="footer-logo">My<span>Republic</span> Support</div>
            <p>© 2026 MyRepublic Indonesia · Customer Complaint & Self-Care Portal</p>
        </div>
    </footer>

    <!-- ── CHAT BUTTON ── -->
    <div class="chat-buttons">
        <button class="chat-btn-komplain" id="btn-komplain">
            <span class="chat-dot"></span> 📢 Chat Helpdesk / Komplain
        </button>
    </div>

    <!-- ── CHAT WINDOW (AI KOMPLAIN AGENT) ── -->
    <div class="chat-window" id="win-komplain">
        <div class="chat-header komplain-header">
            <div class="chat-agent">
                <div class="agent-avatar">📋</div>
                <div>
                    <div class="agent-name">AI Support MyRepublic</div>
                    <div class="agent-status"><span class="status-online"></span> Siap Membantu 24/7</div>
                </div>
            </div>
            <button class="close-chat" id="close-chat-btn">×</button>
        </div>
        <div class="chat-body" id="msg-komplain"></div>
        <div class="chat-footer">
            <input type="text" id="input-komplain" class="chat-input" placeholder="Tuliskan kendala Anda di sini..." autocomplete="off" />
            <button class="chat-send" id="send-komplain">➤</button>
        </div>
    </div>

    <script is:inline>
        // ── FAQ ACCORDION ──
        document.querySelectorAll('.faq-q').forEach(q => {
            q.addEventListener('click', () => {
                const item = q.parentElement;
                const isOpen = item.classList.contains('open');
                document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
                if (!isOpen) item.classList.add('open');
            });
        });

        // ── SCROLL REVEAL ──
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((e, i) => {
                if (e.isIntersecting) {
                    setTimeout(() => e.target.classList.add('visible'), i * 70);
                    observer.unobserve(e.target);
                }
            });
        }, { threshold: 0.08 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        // ── CHAT ENGINE ──
        // === EDIT WEBHOOK DI SINI ===
        const WEBHOOK_KOMPLAIN = 'https://n8n.aleshatour.my.id/webhook/komplain'; // Gantilah dengan Webhook Komplain Anda jika ada perubahan
        // ============================

        const sessionKomplain = 'komplain_' + Math.random().toString(36).substring(7);
        const historyKomplain = [];

        const winKomplain = document.getElementById('win-komplain');
        const btnKomplain = document.getElementById('btn-komplain');
        const closeBtn = document.getElementById('close-chat-btn');
        const btnHeroChat = document.getElementById('btn-hero-chat');
        const btnCtaChat = document.getElementById('btn-cta-chat');

        function toggleChat() {
            winKomplain.classList.toggle('show');
        }

        btnKomplain.addEventListener('click', toggleChat);
        closeBtn.addEventListener('click', () => winKomplain.classList.remove('show'));
        if(btnHeroChat) btnHeroChat.addEventListener('click', () => winKomplain.classList.add('show'));
        if(btnCtaChat) btnCtaChat.addEventListener('click', () => winKomplain.classList.add('show'));

        function addMsg(id, text, type) {
            const box = document.getElementById(id);
            const d = document.createElement('div');
            d.className = 'msg ' + type;
            d.textContent = text;
            box.appendChild(d);
            box.scrollTop = box.scrollHeight;
        }

        function showTyping(id, tid) {
            const box = document.getElementById(id);
            const t = document.createElement('div');
            t.className = 'typing'; t.id = tid;
            t.innerHTML = '<span></span><span></span><span></span>';
            box.appendChild(t); box.scrollTop = box.scrollHeight;
        }

        function hideTyping(tid) { 
            const t = document.getElementById(tid); 
            if (t) t.remove(); 
        }

        async function postWebhook(url, payload) {
            const r = await fetch(url, { 
                method: 'POST', 
                headers: { 'Content-Type': 'application/json' }, 
                body: JSON.stringify(payload) 
            });
            return await r.json();
        }

        // Greeting Pesan Awal Agent
        window.addEventListener('load', () => {
            setTimeout(() => addMsg('msg-komplain',
                'Halo! Saya AI Customer Support MyRepublic 🙏\n\nSampaikan kendala yang Anda alami (misal: Lampu LOS Merah, Internet Lambat, TV Kabel bermasalah, atau pertanyaan tagihan). Saya siap membantu!', 'bot'), 400);
        });

        // Pengiriman Pesan
        document.getElementById('send-komplain').addEventListener('click', sendKomplain);
        document.getElementById('input-komplain').addEventListener('keydown', e => { if (e.key === 'Enter') sendKomplain(); });

        async function sendKomplain() {
            const inp = document.getElementById('input-komplain');
            const txt = inp.value.trim(); 
            if (!txt) return;

            addMsg('msg-komplain', txt, 'user');
            historyKomplain.push({ role: 'user', content: txt });
            inp.value = '';

            showTyping('msg-komplain', 'tp-komplain');

            try {
                const d = await postWebhook(WEBHOOK_KOMPLAIN, {
                    type: 'komplain',
                    message: txt,
                    chatId: sessionKomplain,
                    history: historyKomplain
                });

                hideTyping('tp-komplain');
                const reply = d.reply || d.output || d.message || 'Pesan Anda telah kami terima. Mohon tunggu sebentar...';
                addMsg('msg-komplain', reply, 'bot');
                historyKomplain.push({ role: 'assistant', content: reply });
            } catch { 
                hideTyping('tp-komplain'); 
                addMsg('msg-komplain', 'Maaf, terjadi kendala sambungan ke server. Silakan coba kembali beberapa saat lagi.', 'bot'); 
            }
        }
    </script>
</body>
</html>
